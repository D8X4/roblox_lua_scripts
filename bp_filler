-- ── fill logic ──
local function fillOneBlueprint(bp, plankEntry, root)
    if not bp or not bp.Parent then return false, "no bp" end
    if not plankEntry or not plankEntry.part or not plankEntry.part.Parent then
        return false, "no plank"
    end
    local center = blueprintCenter(bp)
    if not center then return false, "no center" end
    local goalCF = CFrame.new(center)
    local ok = teleportObjectTo(plankEntry.part, goalCF, root)
    return ok, ok and "ok" or "ownership timeout"
end

local function fillAllBlueprints()
    if autoFillRunning then
        autoFillCancel = true
        setStatus("Cancelling...")
        return
    end

    local pl = collectMatchingPlanks()
    if #pl == 0 then
        setStatus("No matching planks (check filter / tree class)")
        return
    end

    local bps = collectBlueprints()
    if #bps == 0 then
        setStatus("No owned blueprints found")
        return
    end

    autoFillRunning = true
    autoFillCancel = false
    setStatus(string.format("Auto fill: %d bps, %d planks", #bps, #pl))

    task.spawn(function()
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        local plankIdx = 1
        local filled, failed = 0, 0

        for i, bp in ipairs(bps) do
            if autoFillCancel then break end
            if not bp.Parent then continue end

            local plankEntry = nil
            for _ = 1, #pl do
                local e = pl[plankIdx]
                plankIdx = (plankIdx % #pl) + 1
                if e.part and e.part.Parent then
                    plankEntry = e; break
                end
            end
            if not plankEntry then
                setStatus("Ran out of matching planks")
                break
            end

            setStatus(string.format("Filling %d/%d (%s)", i, #bps, bp.Name))

            local ok = fillOneBlueprint(bp, plankEntry, root)
            if ok then filled += 1 else failed += 1 end
            task.wait(fillDelay)
        end

        autoFillRunning = false
        setStatus(string.format("Auto fill done: %d filled, %d failed", filled, failed))
    end)
end

local function loopTick()
    if loopRunning then return end
    if #collectMatchingPlanks() == 0 then
        setStatus("Loop: waiting for planks...")
        return
    end

    local bps = collectBlueprints()
    if #bps == 0 then return end

    loopRunning = true
    task.spawn(function()
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        local pl = collectMatchingPlanks()
        local plankIdx = 1
        local filled = 0

        for _, bp in ipairs(bps) do
            if not loopMode then break end
            if not bp.Parent then continue end
            local plankEntry = nil
            for _ = 1, #pl do
                local e = pl[plankIdx]
                plankIdx = (plankIdx % math.max(1, #pl)) + 1
                if e.part and e.part.Parent then
                    plankEntry = e; break
                end
            end
            if not plankEntry then break end
            setStatus(string.format("Loop: filling %s", bp.Name))
            if fillOneBlueprint(bp, plankEntry, root) then
                filled += 1
            end
            task.wait(fillDelay)
        end
        loopRunning = false
        setStatus(string.format("Loop pass: filled %d", filled))
    end)
end

local function stopClickMode()
    clickMode = false
    if clickConn then clickConn:Disconnect(); clickConn = nil end
    if clickToggleHandle then
        pcall(function() clickToggleHandle:Set(false) end)
    end
end

local clickToggleHandle = nil

local function startClickMode()
    clickMode = true
    clickConn = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not clickMode then return end
        if not gui.Parent then return end

        local target = Mouse.Target
        if not target then return end
        local node = target
        local pm = getPlayerModels()
        while node and node.Parent ~= pm do node = node.Parent end
        if not node or not pm then return end
        if not isBlueprint(node) then return end

        local pl = collectMatchingPlanks()
        if #pl == 0 then
            setStatus("No matching planks")
            return
        end
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        local entry = pl[1]
        setStatus(string.format("Click fill: %s", node.Name))
        task.spawn(function()
            if fillOneBlueprint(node, entry, root) then
                setStatus("Filled " .. node.Name)
            else
                setStatus("Fill failed")
            end
        end)
    end)
end

-- pick plank mode
local pickMode = false
local pickConn = nil

local function stopPickMode()
    pickMode = false
    if pickConn then pickConn:Disconnect(); pickConn = nil end
    if pickBtnHandle then
        pcall(function() pickBtnHandle.Text = "Pick Plank" end)
    end
end

local pickBtnHandle = nil

local function startPickMode()
    if pickMode then stopPickMode(); return end
    pickMode = true
    if pickBtnHandle then pickBtnHandle.Text = "Click a plank..." end

    pickConn = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not pickMode then return end

        local target = Mouse.Target
        if not target then return end
        local node = target
        local pm = getPlayerModels()
        while node and node.Parent ~= pm do node = node.Parent end
        if not node or not pm then stopPickMode(); return end
        if not isLoosePlank(node) then
            setStatus("Not your loose plank")
            stopPickMode(); return
        end
        local tc = plankTreeClass(node)
        local y = plankSizeY(node)
        if tc and y then
            selectedTreeClass = tc
            filterMinY = math.max(0, y - 0.2)
            filterMaxY = y + 0.2
            setStatus(string.format("Picked %s (y=%.2f)", tc, y))
        end
        stopPickMode()
    end)
end

-- inventory scan
local function updateInventory()
    local byTree, total = scanPlanks()
    if inventoryPara then
        if total == 0 then
            pcall(function() inventoryPara:setDesc(inventoryPara, "(no loose planks)") end)
        else
            local parts = {}
            for tc, data in pairs(byTree) do
                local sizeParts = {}
                for s, c in pairs(data.sizes) do
                    table.insert(sizeParts, s .. "x" .. c)
                end
                table.sort(sizeParts)
                table.insert(parts, string.format("%s(%d): %s", tc, data.count, table.concat(sizeParts, ",")))
            end
            table.sort(parts)
            pcall(function()
                inventoryPara:setDesc(inventoryPara, "Total: " .. total .. "  |  " .. table.concat(parts, "  "))
            end)
        end
    end
    -- refresh dropdown
    if treeDropdown then
        local values = { "(All)" }
        for tc, _ in pairs(byTree) do table.insert(values, tc) end
        table.sort(values)
        pcall(function() treeDropdown:SetValues(values) end)
    end
end

