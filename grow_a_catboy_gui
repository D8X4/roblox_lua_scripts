local function scanBackpack()
    local bp = lp:FindFirstChild("Backpack")
    local items = bp and bp:GetChildren() or {}
    
    local out = {}
    table.insert(out, string.format("Total Backpack Items: %d", #items))
    table.insert(out, string.rep("-", 68))
    
    if #items == 0 then
        table.insert(out, "Your backpack is currently empty.")
    else
        for i, item in ipairs(items) do
            pcall(function()
                local attrs = item:GetAttributes()
                local itemName = item.Name
                local rarity = attrs.Rarity or "Common"
                local income = attrs.Income and ("(+" .. tostring(attrs.Income) .."/s)") or ""
                local itemId = attrs.ItemId or ""
                table.insert(out, string.format("[%02d] [%-5s] %-26s  %-10s  %s", i, itemId, tostring(itemName), tostring(rarity), income))
            end)
        end
    end

    local finalStr = table.concat(out, "\n")
    set(bpDisplay, { Text = finalStr, Size = UDim2.fromOffset(750, #out * 22) })
    bpScrollBox.CanvasSize = UDim2.fromOffset(0, #out * 22 + 20)
end

