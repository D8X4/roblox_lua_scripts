-- Helper to check if an egg is ready to hatch based on its status attributes
local function isEggReady(placedItem)
    local attrs = placedItem:GetAttributes()
    local status = attrs.Status or attrs.State or attrs.EggState or attrs.Progress
    -- Check common status indicators for readiness (e.g. "Ready", "Hatchable", numeric max progress, etc.)
    if status == "Ready" or status == "Hatchable" or status == true then
        return true
    end
    if type(status) == "number" and status >= 100 then
        return true
    end
    -- If no explicit status attribute is found, we check if it has a prompt or specific model child
    if placedItem:FindFirstChild("ProximityPrompt") or placedItem:FindFirstChild("Interact") then
        return true
    end
    -- Fallback: if we can't find a negative indicator, assume it can be checked
    return true
end

local function hatchReadyEggs()
    local placedFolder = Workspace:FindFirstChild("Runtime") and Workspace.Runtime:FindFirstChild("Placed")
    if not placedFolder then return end
    
    local slot = lp:GetAttributes().PlotSlot or 4
    for _, placedItem in ipairs(placedFolder:GetChildren()) do
        pcall(function()
            local attrs = placedItem:GetAttributes()
            if attrs.BaseIndex == slot or attrs.PlotSlot == slot or attrs.OwnerUserId == lp.UserId then
                if attrs.ItemKind == "Egg" or string.find(string.lower(placedItem.Name), "egg") then
                    if isEggReady(placedItem) and (placedItem:IsA("BasePart") or placedItem:IsA("Model")) then
                        local pivot = placedItem:GetPivot()
                        smoothMoveTo(pivot + Vector3.new(0, 3, 0))
                        task.wait(0.4)
                        holdE(1.5)
                    end
                end
            end
        end)
    end
    lw.teleport(wheel_pos)
end

