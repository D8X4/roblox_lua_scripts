local lastStatus = ""
local function setStatus(msg)
    if msg ~= lastStatus then
        lastStatus = msg
        set(statusLabel, { Text = msg })
    end
end

local dragging = false
local dragOffset = Vector2.new(0, 0)

local function inRect(m, x, y, w, h)
    return m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h
end

UIS.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        if not state.shown then return end
        local m = UIS:GetMouseLocation()
        local top = origin + Vector2.new(0, INSET_Y)

        for _, h in hits do
            if (h.tab == nil or h.tab == activeTab) and inRect(m, top.X + h.x, top.Y + h.y, h.w, h.h) then
                h.onClick()
                refresh()
                return
            end
        end

        if inRect(m, top.X, top.Y, WIN_W, TITLE_H) then
            dragging = true
            dragOffset = m - top
        end
    elseif inp.KeyCode == HIDE_KEY then
        state.shown = not state.shown
        set(root, { Visible = state.shown })
    end
end)

UIS.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

RunService.RenderStepped:Connect(function()
    if not dragging then return end
    local m = UIS:GetMouseLocation()
    local vp = lw.viewport()
    local pos = m - dragOffset - Vector2.new(0, INSET_Y)
    origin = Vector2.new(
        math.clamp(pos.X, 0, math.max(0, vp.X - WIN_W)),
        math.clamp(pos.Y, 0, math.max(0, vp.Y - WIN_H))
    )
    set(root, { Position = UDim2.fromOffset(origin.X, origin.Y) })
end)

local function getNests(folderName)
    local corridor = Workspace:FindFirstChild("Corridor")
    local zonesFolder = corridor and corridor:FindFirstChild("Zones")
    local zone = zonesFolder and zonesFolder:FindFirstChild(folderName)
    return zone and zone:FindFirstChild("Nests")
end

local function guardInfo(zoneIndex)
    local runtime = Workspace:FindFirstChild("Runtime")
    local folder = runtime and runtime:FindFirstChild("Guards")
    if not folder then return nil end
    for _, g in folder:GetChildren() do
        local attrs = g:GetAttributes()
        if attrs.ZoneIndex == zoneIndex then
            return attrs.GuardState, attrs.TargetUserId
        end
    end
    return nil
end

local function waitForGuard(z)
    if not state.guardGate then return true end
    local waited = 0
    while state.master and state.running and z.enabled do
        local gs, target = guardInfo(z.index)
        if gs == nil or (gs == "Sleep" and (target == nil or target == 0)) then
            return true
        end
        setStatus(string.format("Status: %s guard is %s, waiting", z.name, tostring(gs)))
        task.wait(0.5)
        waited += 0.5
        if waited >= 15 then return false end
    end
    return false
end

local function atWheel()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end
    return (hrp.Position - wheel_pos.Position).Magnitude < 10
end

local function farmZone(z)
    local folder = getNests(z.folder)
    if not folder then
        setStatus("Status: " .. z.name .. " not found")
        task.wait(1)
        return
    end

    local nests = folder:GetChildren()
    table.sort(nests, function(a, b) return a.Name < b.Name end)

    for _, nest in nests do
        if not state.master or not z.enabled or not state.running then return end

        local target = z.child == nil or nest:FindFirstChild(z.child)
        if target and nest:IsA("BasePart") then
            if not waitForGuard(z) then continue end

            if not input.focused() then
                setStatus("Status: click the game window (input needs focus)")
                task.wait(1)
                continue
            end

            setStatus(string.format("Status: %s %s", z.name, nest.Name))
            lw.teleport(nest.CFrame + Vector3.new(0, 3, 0))
            task.wait(0.3)

            holdE(z.hold)
            lw.teleport(wheel_pos)
            task.wait(COOLDOWN)
        end
    end
end

refresh()

while state.running do
    if state.master then
        for _, z in zones do
            if not state.master or not state.running then break end
            if z.enabled then
                farmZone(z)
            end
        end
        if state.master and state.running then
            lw.teleport(wheel_pos)
            setStatus("Status: cycle done, starting over")
            task.wait(1)
        end
    elseif state.wheel then
        if atWheel() then
            setStatus("Status: on the wheel")
        else
            setStatus("Status: going to the wheel")
            lw.teleport(wheel_pos)
            task.wait(1)
        end
    else
        setStatus("Status: idle")
    end
    task.wait(0.25)
end

