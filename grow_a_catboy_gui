local function getAvailablePlotSpot()
    local slot = lp:GetAttributes().PlotSlot or 4
    local placedFolder = Workspace:FindFirstChild("Runtime") and Workspace.Runtime:FindFirstChild("Placed")
    
    local occupied = {}
    if placedFolder then
        for _, item in ipairs(placedFolder:GetChildren()) do
            pcall(function()
                local attrs = item:GetAttributes()
                if attrs.BaseIndex == slot or attrs.PlotSlot == slot or attrs.OwnerUserId == lp.UserId then
                    local pos = item:GetPivot().Position
                    table.insert(occupied, {x = pos.X, z = pos.Z})
                end
            end)
        end
    end

    for _, pt in ipairs(gridOffsets) do
        local clear = true
        for _, occ in ipairs(occupied) do
            if math.abs(occ.x - pt.x) < 3 and math.abs(occ.z - pt.z) < 3 then
                clear = false
                break
            end
        end
        if clear then
            return pt.x, pt.z
        end
    end
    return nil, nil
end

