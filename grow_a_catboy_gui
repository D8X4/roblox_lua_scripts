-- Smooth tween movement function used for Headpats and Hatching
local function smoothMoveTo(targetCFrame)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        lw.teleport(targetCFrame)
        return 
    end
    
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 65 -- studs per second travel speed
    local duration = math.clamp(dist / speed, 0.1, 1.2)
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

local function computeWheelPos()
    local bases = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Bases")
    local slot = lp:GetAttributes().PlotSlot
    local mine = bases and slot and bases:FindFirstChild("Base" .. tostring(slot))
    local ref = bases and bases:FindFirstChild("Base8")
    local myTread = mine and mine:FindFirstChild("Treadmill")
    local refTread = ref and ref:FindFirstChild("Treadmill")
    if not myTread or not refTread then
        warn("couldn't find your treadmill, using the old wheel_pos")
        return CFrame.new(-261, 7, 570)
    end
    local rel = refTread:GetPivot():ToObjectSpace(CFrame.new(-261, 7, 570))
    return CFrame.new((myTread:GetPivot() * rel).Position)
end

