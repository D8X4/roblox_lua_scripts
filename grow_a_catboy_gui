local function teleportToZoneName(zoneName)
    local corridor = Workspace:FindFirstChild("Corridor")
    local zonesFolder = corridor and corridor:FindFirstChild("Zones")
    local zone = zonesFolder and zonesFolder:FindFirstChild(zoneName)
    if zone then
        local nests = zone:FindFirstChild("Nests")
        if nests and #nests:GetChildren() > 0 then
            for _, nest in ipairs(nests:GetChildren()) do
                if nest:IsA("BasePart") then
                    lw.teleport(nest.CFrame + Vector3.new(0, 3, 0))
                    print("Teleported to " .. zoneName)
                    return
                end
            end
        end
        if zone:IsA("Model") or zone:IsA("BasePart") then
            lw.teleport(zone:GetPivot() + Vector3.new(0, 3, 0))
            print("Teleported to " .. zoneName)
            return
        end
    end
    warn("Could not find zone folder for " .. zoneName)
end

