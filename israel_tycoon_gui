local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15 }

local function parseNumber(str)
	if type(str) ~= "string" then return nil end
	local s = string.lower((string.gsub(str, ",", "")))
	local num, suf = string.match(s, "(%d+%.?%d*)%s*([a-z]*)")
	if not num then return nil end
	return tonumber(num) * (SUFFIX[suf] or 1)
end

local function fmt(n)
	local rev = string.reverse(string.format("%.0f", n))
	rev = string.gsub(rev, "(%d%d%d)", "%1,")
	local out = string.reverse(rev)
	if string.sub(out, 1, 1) == "," then out = string.sub(out, 2) end
	return out
end

local function hasName(str, name)
	if type(str) ~= "string" or type(name) ~= "string" or name == "" then
		return false
	end
	str, name = string.lower(str), string.lower(name)
	local init = 1
	while true do
		local s, e = string.find(str, name, init, true)
		if not s then return false end
		local before = s > 1 and string.sub(str, s - 1, s - 1) or ""
		local after = string.sub(str, e + 1, e + 1)
		if not string.match(before, "[%w_]") and not string.match(after, "[%w_]") then
			return true
		end
		init = s + 1
	end
end

local function signTitle(plot)
	local entrance = plot:FindFirstChild("Entrance")
	local sign = entrance and entrance:FindFirstChild("Sign")
	local sg = sign and sign:FindFirstChild("SignGui_Front")
	local fr = sg and sg:FindFirstChild("Frame")
	local title = fr and fr:FindFirstChild("Title")
	if not title then return nil end
	return title.Text
end

local function findMyPlot()
	local plotsFolder = Workspace:FindFirstChild("IsraelTycoons")
	if not plotsFolder then return nil end
	for _, plot in plotsFolder:GetChildren() do
		local t = signTitle(plot)
		if hasName(t, lp.Name) or hasName(t, lp.DisplayName) then
			return plot
		end
	end
	return nil
end

local function getPlotCFrame(plot)
	local pad = plot:FindFirstChild("CashPad")
	if pad then
		return CFrame.new(pad:GetPivot().Position + Vector3.new(0, 3, 0))
	end
	local entrance = plot:FindFirstChild("Entrance")
	if entrance then
		return CFrame.new(entrance:GetPivot().Position + Vector3.new(0, 3, 0))
	end
	local ok, cf = pcall(function() return plot:GetBoundingBox() end)
	if ok and cf then
		return CFrame.new(cf.Position + Vector3.new(0, 3, 0))
	end
	return CFrame.new(plot:GetPivot().Position + Vector3.new(0, 3, 0))
end

local COST_KEYS = { "Price", "Cost", "price", "cost", "Amount" }

local function valueOf(inst)
	local ok, v = pcall(function() return inst.Value end)
	if ok then return v end
end

local function readCost(inst)
	local attrs = inst:GetAttributes()
	for _, k in COST_KEYS do
		local v = attrs[k]
		if type(v) == "number" then return v end
		if type(v) == "string" then
			local n = parseNumber(v)
			if n then return n end
		end
	end
	local best
	for _, d in inst:GetDescendants() do
		local cls = d.ClassName
		if (cls == "NumberValue" or cls == "IntValue" or cls == "StringValue") and table.find(COST_KEYS, d.Name) then
			local v = valueOf(d)
			if type(v) == "number" then return v end
			if type(v) == "string" then
				local n = parseNumber(v)
				if n then return n end
			end
		elseif cls == "TextLabel" or cls == "TextButton" then
			local t = d.Text
			if type(t) == "string" and string.find(t, "%d") then
				if string.find(t, "$", 1, true) or d.Name == "Price" or d.Name == "Cost" then
					local n = parseNumber(t)
					if n then return n end
				end
				best = best or parseNumber(t)
			end
		end
	end
	return best
end

local MONEY_KEYS = { "Cash", "Money", "Coins", "Gold", "Balance" }

local function readMoney()
	local ls = lp:FindFirstChild("leaderstats")
	if ls then
		for _, k in MONEY_KEYS do
			local v = ls:FindFirstChild(k)
			if v then
				local val = valueOf(v)
				if type(val) == "number" then return val end
			end
		end
		for _, v in ls:GetChildren() do
			if v.ClassName == "NumberValue" or v.ClassName == "IntValue" then
				local val = valueOf(v)
				if type(val) == "number" then return val end
			end
		end
	end
	local attrs = lp:GetAttributes()
	for _, k in MONEY_KEYS do
		if type(attrs[k]) == "number" then return attrs[k] end
	end
	return nil
end

local PAD_MONEY_KEYS = { "Cash", "Money", "Stored", "Amount", "Balance", "Collected", "Value" }

local function readPadMoney(pad)
	local attrs = pad:GetAttributes()
	for _, k in PAD_MONEY_KEYS do
		local v = attrs[k]
		if type(v) == "number" then return v end
		if type(v) == "string" then
			local n = parseNumber(v)
			if n then return n end
		end
	end
	local best
	for _, d in pad:GetDescendants() do
		local cls = d.ClassName
		if (cls == "NumberValue" or cls == "IntValue" or cls == "StringValue") and table.find(PAD_MONEY_KEYS, d.Name) then
			local v = valueOf(d)
			if type(v) == "number" then return v end
			if type(v) == "string" then
				local n = parseNumber(v)
				if n then return n end
			end
		elseif cls == "TextLabel" or cls == "TextButton" then
			local t = d.Text
			if type(t) == "string" and string.find(t, "%d") then
				if string.find(t, "$", 1, true) then
					local n = parseNumber(t)
					if n then return n end
				end
				best = best or parseNumber(t)
			end
		end
	end
	return best
end

local PAD_NAMES = { "Pad", "Button", "Touch", "Trigger", "Hitbox" }

local function padCFrame(inst)
	local target
	if inst:IsA("BasePart") then
		target = inst
	else
		for _, n in PAD_NAMES do
			local f = inst:FindFirstChild(n, true)
			if f and f:IsA("BasePart") then
				target = f
				break
			end
		end
	end
	if target then
		return CFrame.new(target.Position + Vector3.new(0, target.Size.Y / 2 + 3, 0))
	end
	if inst:IsA("Model") then
		local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
		if ok and cf then
			return CFrame.new(cf.Position + Vector3.new(0, size.Y / 2 + 3, 0))
		end
	end
	return CFrame.new(inst:GetPivot().Position + Vector3.new(0, 3, 0))
end

