local function equipWeapon(weaponKeyword)
	if not myPlot then return end
	flash("Equipping " .. weaponKeyword .. "...")
	
	local items = myPlot:FindFirstChild("Items")
	local targetPad

	if items then
		for _, item in items:GetChildren() do
			if string.find(string.lower(item.Name), string.lower(weaponKeyword)) then
				local giver = item:FindFirstChild("WeaponGiver")
				if giver then
					targetPad = giver
					break
				end
			end
		end
	end

	if targetPad then
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local back = hrp.CFrame
		
		lw.teleport(padCFrame(targetPad))
		task.wait(0.2)
		lw.teleport(back)
	else
		flash("Couldn't find pad for " .. weaponKeyword)
	end
end

