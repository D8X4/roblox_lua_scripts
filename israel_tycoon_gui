-- ==================== MAIN LOOP ====================
selectTab(plotTab)

local lastAutoCollectTick = 0
local lastAutoBuyTick = 0
local lastAutoKothTick = 0
local lastCrateTick = 0
local lastRebirthTick = 0

local function updateData()
	if not myPlot then
		myPlot = findMyPlot()
	end
	updateTeleportsList()
	updatePlayerList()

	money = readMoney()
	entries = buildEntries()

	local pad = myPlot and myPlot:FindFirstChild("CashPad")
	padMoney = pad and readPadMoney(pad) or nil
	local padText = padMoney and ("$" .. fmt(padMoney)) or "?"
	if padText ~= lastPadText then
		lastPadText = padText
		set(cashLabel, { Text = padText })
	end

	local parts = { tostring(page), tostring(money) }
	for _, e in entries do
		parts[#parts + 1] = e.name .. ":" .. tostring(e.cost) .. ":" .. tostring(canAfford(e))
	end
	local sig = table.concat(parts, "|")
	if sig ~= lastSig then
		lastSig = sig
		renderRows()
	end

	local currentOwner = readCaptureOwner()
	set(kothStatusLabel, { Text = "King of the Hill: " .. tostring(currentOwner) })

	if settingsState.autoCollect and (os.clock() - lastAutoCollectTick >= settingsState.autoCollectInterval) then
		lastAutoCollectTick = os.clock()
		task.spawn(collectMoney)
	end

	if settingsState.autoBuy and #entries > 0 and (os.clock() - lastAutoBuyTick >= 1.0) then
		lastAutoBuyTick = os.clock()
		local nextTarget = entries[1]
		if nextTarget and canAfford(nextTarget) then
			task.spawn(function()
				goTo(nextTarget)
			end)
		end
	end

	if settingsState.autoKoth and not capturingKoth and (os.clock() - lastAutoKothTick >= settingsState.autoKothInterval) then
		lastAutoKothTick = os.clock()
		local ownerStr = string.lower(tostring(currentOwner))
		if not string.find(ownerStr, string.lower(lp.Name)) then
			task.spawn(captureHill)
		end
	end

	if settingsState.autoCrates and (os.clock() - lastCrateTick >= 1.0) then
		lastCrateTick = os.clock()
		task.spawn(function()
			local char = lp.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			
			for _, d in Workspace:GetChildren() do
				local name = string.lower(d.Name)
				if (string.find(name, "crate") or string.find(name, "box")) and not d:IsDescendantOf(lp.Character) then
					local pos = d:IsA("Model") and d:GetPivot().Position or (d:IsA("BasePart") and d.Position)
					if pos then
						lw.teleport(CFrame.new(pos + Vector3.new(0, 3, 0)))
						task.wait(0.2)
					end
				end
			end
		end)
	end

	if settingsState.autoRebirth and (os.clock() - lastRebirthTick >= 2.0) then
		lastRebirthTick = os.clock()
		if money and money >= 1000000 then
			task.spawn(function()
				if myPlot then
					for _, d in myPlot:GetDescendants() do
						local name = string.lower(d.Name)
						if string.find(name, "rebirth") then
							local ok, cf = pcall(padCFrame, d)
							if ok then
								lw.teleport(cf)
								task.wait(0.3)
								lw.teleport(getPlotCFrame(myPlot))
								flash("Auto-Rebirthed!")
								break
							end
						end
					end
				end
			end)
		end
	end

	-- Auto-Kill All background loop
	if settingsState.autoKillAll then
		task.spawn(function()
			local backpack = lp:FindFirstChild("Backpack")
			local shotgun = backpack and (backpack:FindFirstChild("Shotgun") or backpack:FindFirstChild("ArmeFusilPompe"))
			
			if shotgun then
				local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
				if hum then
					hum:EquipTool(shotgun)
					task.wait(0.3)
				end
			end

			-- Loop through all alive players once per cycle
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
					executeTarget(p.Name, backpack)
				end
			end
			
			-- Return to base after killing everyone
			if myPlot then
				local camera = Workspace.CurrentCamera
				camera.CameraType = Enum.CameraType.Custom
				camera.CameraSubject = lp.Character and lp.Character:FindFirstChild("Humanoid")
				lp.CameraMinZoomDistance = 0.5
				lp.CameraMaxZoomDistance = 400
				lw.teleport(getPlotCFrame(myPlot))
			end
		end)
	end

	if os.clock() >= statusHoldUntil then
		if not myPlot then
			setStatus("Looking for your plot...")
		else
			setStatus(string.format("Plot: %s   Money: %s   Buttons: %d", myPlot.Name, money and fmt(money) or "?", #entries))
		end
	end
end

local dragging = false
local dragOffset = Vector2.new(0, 0)

local function inRect(m, x, y, w, h)
	return m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h
end

UIS.InputBegan:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 then
		if not state.shown then return end
		local m = UIS:GetMouseLocation()
		local top = origin + Vector2.new(0, INSET_Y)

		for _, h in hits do
			if (h.tab == nil or h.tab == activeTab) and inRect(m, top.X + h.x, top.Y + h.y, h.w, h.h) then
				h.onClick()
				return
			end
		end

		if inRect(m, top.X, top.Y, WIN_W, TITLE_H) then
			dragging = true
			dragOffset = m - top
		end
	elseif inp.KeyCode == HIDE_KEY then
		state.shown = not state.shown
		set(root, { Visible = state.shown })
	end
end)

UIS.InputEnded:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if not dragging then return end
	local m = UIS:GetMouseLocation()
	local vp = lw.viewport()
	local pos = m - dragOffset - Vector2.new(0, INSET_Y)
	origin = Vector2.new(
		math.clamp(pos.X, 0, math.max(0, vp.X - WIN_W)),
		math.clamp(pos.Y, 0, math.max(0, vp.Y - WIN_H))
	)
	set(root, { Position = UDim2.fromOffset(origin.X, origin.Y) })
end)

while state.running do
	local ok, err = pcall(updateData)
	if not ok then
		warn("refresh failed: " .. tostring(err))
	end
	task.wait(REFRESH_EVERY)
end

