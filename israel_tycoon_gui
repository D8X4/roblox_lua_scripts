local selectedPlayers = {}
local playerListContainer = frame(combCard, 14, 134, WIN_W - 52, 170, C.bg, true)
local playerButtons = {}
local lastPlayerSig = ""

local function updatePlayerList()
	local pList = Players:GetPlayers()
	table.sort(pList, function(a,b) return a.Name < b.Name end)
	
	local sig = ""
	for _, p in ipairs(pList) do sig = sig .. p.Name .. "|" end
	
	if sig == lastPlayerSig and #playerButtons > 0 then return end
	lastPlayerSig = sig
	
	for _, b in playerButtons do b:Destroy() end
	playerButtons = {}
	
	for i = #hits, 1, -1 do
		if hits[i].isDynamicPlayer then table.remove(hits, i) end
	end
	
	local colW = math.floor((WIN_W - 82) / 2)
	for i, p in ipairs(pList) do
		if p ~= lp then
			local idx = #playerButtons
			local col = idx % 2
			local row = math.floor(idx / 2)
			local x = 10 + col * (colW + 10)
			local y = 10 + row * 40
			
			local isSelected = selectedPlayers[p.Name] == true
			local pBtn, hitEntry = button(newArea(combatTab, playerListContainer, 14, 134), x, y, colW, 32, p.Name, nil)
			
			if isSelected then
				set(pBtn, { BackgroundColor3 = C.accent })
			end
			
			hitEntry.onClick = function()
				if selectedPlayers[p.Name] then
					selectedPlayers[p.Name] = nil
					set(pBtn, { BackgroundColor3 = C.btn })
				else
					selectedPlayers[p.Name] = true
					set(pBtn, { BackgroundColor3 = C.accent })
				end
			end
			
			hitEntry.isDynamicPlayer = true
			playerButtons[#playerButtons + 1] = pBtn
		end
	end
end

local function executeTarget(playerName, backpack)
	local targetPlayer = Players:FindFirstChild(playerName)
	if not targetPlayer or not targetPlayer.Character then return false end
	
	local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	local hum = targetPlayer.Character:FindFirstChild("Humanoid")
	if not hrp or not hum then return false end
	
	flash("Executing " .. playerName .. "...")
	local camera = Workspace.CurrentCamera
	local originalCameraType = camera.CameraType
	local originalMinZoom = lp.CameraMinZoomDistance
	local originalMaxZoom = lp.CameraMaxZoomDistance

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CameraSubject = nil
	lp.CameraMinZoomDistance = 0.5
	lp.CameraMaxZoomDistance = 0.5

	local angle = 0
	local spinRadius = 6 
	local teleportRadius = 3 
	
	-- Release any previous click just in case
	pcall(function() VirtualUser:Button1Up(Vector2.new(0, 0)) end)

	for i = 1, 200 do 
		if not hrp or not hrp.Parent or hum.Health <= 0 then break end
		
		angle = angle + math.rad(45) 
		
		-- 1. SPECTATOR CAMERA
		local offsetX = math.cos(angle) * spinRadius
		local offsetZ = math.sin(angle) * spinRadius
		local camPos = hrp.Position + Vector3.new(offsetX, 2, offsetZ)
		camera.CFrame = CFrame.new(camPos, hrp.Position)
		
		-- 2. TELEPORT (Throttled to avoid hitting the 20 calls/sec limit)
		local tpX = math.cos(angle) * teleportRadius
		local tpZ = math.sin(angle) * teleportRadius
		local tpPos = hrp.Position + Vector3.new(tpX, 0, tpZ)
		
		pcall(function()
			lw.teleport(CFrame.new(tpPos, hrp.Position))
		end)
		
		-- 3. SHOOT: Fast click spam to simulate rapid fire
		VirtualUser:Button1Down(Vector2.new(0, 0))
		task.wait(0.01)
		VirtualUser:Button1Up(Vector2.new(0, 0))
		
		-- Safety delay to not crash the client or hit teleport limit
		task.wait(0.05)
	end
	
	-- Release mouse on finish
	pcall(function() VirtualUser:Button1Up(Vector2.new(0, 0)) end)

	camera.CameraType = originalCameraType
	lp.CameraMinZoomDistance = originalMinZoom
	lp.CameraMaxZoomDistance = originalMaxZoom
	
	return hum.Health <= 0
end

