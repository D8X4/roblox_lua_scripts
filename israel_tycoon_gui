local warned = {}
local function set(inst, props)
	for k, v in props do
		local ok, err = pcall(function() inst[k] = v end)
		if not ok then
			local key = tostring(inst and inst.ClassName) .. "." .. k
			if not warned[key] then
				warned[key] = true
				warn("couldn't set " .. key .. ": " .. tostring(err))
			end
		end
	end
end

local function make(class, parent, props)
	local inst = Instance.new(class, parent)
	set(inst, props)
	return inst
end

local function try(fn)
	local ok, v = pcall(fn)
	if ok then return v end
end

