local function getCaptureZone()
	local map = Workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("CaptureZone")
end

local function getCaptureText()
	local zone = getCaptureZone()
	if not zone then return "" end
	
	local ownerAttr = zone:GetAttribute("Owner") or zone:GetAttribute("Team") or zone:GetAttribute("CapturedBy")
	if type(ownerAttr) == "string" and ownerAttr ~= "" then
		return ownerAttr
	end

	for _, d in zone:GetDescendants() do
		if d.ClassName == "TextLabel" or d.ClassName == "TextButton" then
			local t = d.Text
			if type(t) == "string" and #t > 0 and #t < 60 then
				local lt = string.lower(t)
				if lt ~= "king of the hill" and lt ~= "capture zone" then
					return t
				end
			end
		elseif d.ClassName == "StringValue" then
			local n = string.lower(d.Name)
			if string.find(n, "owner") or string.find(n, "team") or string.find(n, "captur") then
				if type(d.Value) == "string" and d.Value ~= "" then
					return d.Value
				end
			end
		end
	end
	return ""
end

local function readCaptureOwner()
	local text = getCaptureText()
	if text == "" then return "Uncaptured / Neutral" end
	return text
end

local capturingKoth = false

local function captureHill()
	if capturingKoth then return end
	capturingKoth = true

	local zone = getCaptureZone()
	if not zone then
		flash("CaptureZone not found in Workspace.Map!")
		capturingKoth = false
		return
	end

	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	if not hrp or not hum then
		capturingKoth = false
		return
	end

	local zoneCFrame
	if zone:IsA("BasePart") then
		zoneCFrame = zone.CFrame
	else
		zoneCFrame = zone:GetPivot()
	end

	local originalWalkSpeed = hum.WalkSpeed
	hum.WalkSpeed = 0

	lw.teleport(zoneCFrame)
	task.wait(3.5)

	local timeout = os.clock() + 45
	local captured = false
	local hasSeenPercent = false

	while os.clock() < timeout do
		if not hrp or not hrp.Parent then break end
		
		if (hrp.Position - zoneCFrame.Position).Magnitude > 10 then
			lw.teleport(zoneCFrame)
		end
		
		local text = getCaptureText()
		local lt = string.lower(text)
		
		local percent = tonumber(string.match(lt, "(%d+)%%"))
		
		if percent then
			hasSeenPercent = true
			if percent >= 100 then
				captured = true
				break
			end
		else
			if hasSeenPercent and (string.find(lt, string.lower(lp.Name)) or string.find(lt, string.lower(lp.DisplayName))) then
				captured = true
				break
			end
		end
		
		task.wait(0.2)
	end

	hum.WalkSpeed = originalWalkSpeed

	if myPlot then
		lw.teleport(getPlotCFrame(myPlot))
	end
	
	capturingKoth = false
	if captured then
		flash("Successfully captured the Hill! Returned to base.")
	else
		flash("Capture timeout! Returned to base.")
	end
end

