local function updateTeleportsList()
	local plotsFolder = Workspace:FindFirstChild("IsraelTycoons")
	if not plotsFolder then return end

	local plots = plotsFolder:GetChildren()
	table.sort(plots, function(a, b)
		local numA = tonumber(string.match(a.Name, "%d+"))
		local numB = tonumber(string.match(b.Name, "%d+"))
		if numA and numB and numA ~= numB then
			return numA < numB
		end
		return a.Name < b.Name
	end)

	local sigParts = {}
	for _, p in plots do
		sigParts[#sigParts + 1] = p.Name
	end
	local sig = table.concat(sigParts, "|")
	if sig == lastPlotSig and #otherPlotButtons > 0 then
		return
	end
	lastPlotSig = sig

	for _, btn in otherPlotButtons do
		if btn and btn.Parent then btn:Destroy() end
	end
	otherPlotButtons = {}

	for i = #hits, 1, -1 do
		if hits[i].isDynamicPlot then
			table.remove(hits, i)
		end
	end

	local colW = math.floor((WIN_W - 82) / 2)
	for i, plot in ipairs(plots) do
		local col = (i - 1) % 2
		local row = math.floor((i - 1) / 2)
		local xOffset = 10 + col * (colW + 10)
		local yOffset = 10 + row * 40

		local labelText = plot.Name
		if plot == myPlot then
			labelText = labelText .. " (Yours)"
		end

		local pBtn, hitEntry = button(otherPlotsArea, xOffset, yOffset, colW, 32, labelText, function()
			teleportToPlot(plot)
		end)
		if plot == myPlot then
			set(pBtn, { BackgroundColor3 = C.accent })
		end
		hitEntry.isDynamicPlot = true
		otherPlotButtons[#otherPlotButtons + 1] = pBtn
	end
end

