	page = math.clamp(page, 1, pages)
	for i = 1, ROWS do
		local e = entries[(page - 1) * ROWS + i]
		local r = rows[i]
		r.entry = e
		if e then
			local ok = canAfford(e)
			set(r.bg, { BackgroundTransparency = 0 })
			set(r.name, { Text = e.name })
			set(r.cost, { Text = e.cost and ("$" .. fmt(e.cost)) or "?" })
			set(r.btn, {
				Text = ok and "Buy" or "Can't afford",
				BackgroundTransparency = 0,
				BackgroundColor3 = ok and C.accent or C.off,
				TextColor3 = ok and C.text or C.dim,
			})
		else
			set(r.bg, { BackgroundTransparency = 1 })
			set(r.name, { Text = "" })
			set(r.cost, { Text = "" })
			set(r.btn, { Text = "", BackgroundTransparency = 1 })
		end
	end
	set(pageLabel, { Text = string.format("Page %d / %d", page, pages) })
end

