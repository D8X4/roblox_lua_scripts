local function canAfford(e)
	if not e.cost or not money then return true end
	return money >= e.cost
end

local function buildEntries()
	local folder = myPlot and myPlot:FindFirstChild("Buttons")
	local list = {}
	if folder then
		for _, b in folder:GetChildren() do
			list[#list + 1] = { inst = b, name = b.Name, cost = readCost(b) }
		end
	end
	table.sort(list, function(a, b)
		local ac, bc = a.cost, b.cost
		if ac and bc then
			if ac ~= bc then return ac < bc end
			return a.name < b.name
		end
		if ac then return true end
		if bc then return false end
		return a.name < b.name
	end)
	return list
end

